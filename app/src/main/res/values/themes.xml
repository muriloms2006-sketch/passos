<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Meuspassos" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Rotulo">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rotulo</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TituloSecao">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Botao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Botao.Primario">
        <item name="android:background">@drawable/bg_botao_primario</item>
        <item name="android:textColor">@color/branco</item>
    </style>

    <style name="Botao.Secundario">
        <item name="android:background">@drawable/bg_botao_secundario</item>
        <item name="android:textColor">@color/texto</item>
    </style>
</resources>
