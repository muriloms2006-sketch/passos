<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/txtData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="domingo, 8 de novembro · Cada passo conta!"
            android:textSize="15sp"
            android:textColor="@color/texto_secundario"
            android:paddingBottom="20dp" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rotulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rotulo_passos_hoje" />

                <Button
                    android:id="@+id/btnZerar"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/botao_zerar"
                    android:textSize="14sp"
                    android:textColor="@color/primaria"
                    android:textAllCaps="false" />

            </LinearLayout>

            <com.app.meuspassos.GraficoPassos
                android:id="@+id/grafico"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                app:meta="@integer/meta_diaria"
                app:espessura="18dp"
                app:corProgresso="@color/primaria"
                app:corTrilha="@color/primaria_clara"
                app:corMetaAtingida="@color/sucesso" />

            <TextView
                android:id="@+id/txtMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="Meta diária: 5000 passos"
                android:textSize="14sp"
                android:textColor="@color/texto_secundario"
                android:paddingTop="12dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotulo_distancia" />

                    <TextView
                        android:id="@+id/txtDistancia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0,96 km"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto"
                        android:paddingTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotulo_calorias" />

                    <TextView
                        android:id="@+id/txtCalorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="49 kcal"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto"
                        android:paddingTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/txtFonteSensor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="@string/fonte_sensor_passos"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:paddingTop="14dp" />

        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotulo_posicao_atual" />

            <TextView
                android:id="@+id/txtLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/localizacao_nao_obtida"
                android:textSize="15sp"
                android:textColor="@color/texto"
                android:lineSpacingExtra="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp" />

            <Button
                android:id="@+id/btnLocalizacao"
                style="@style/Botao.Secundario"
                android:text="@string/botao_obter_localizacao" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSalvar"
            style="@style/Botao.Primario"
            android:layout_marginTop="16dp"
            android:text="@string/botao_salvar" />

        <Button
            android:id="@+id/btnHistorico"
            style="@style/Botao.Secundario"
            android:layout_marginTop="10dp"
            tools:text="Ver histórico (3)" />

    </LinearLayout>

</ScrollView>
