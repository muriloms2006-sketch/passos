<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F2FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MEUS PASSOS"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#57446F"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cada passo conta!"
            android:textSize="15sp"
            android:textColor="#93869F"
            android:gravity="center"
            android:paddingBottom="25dp" />

        <!-- Contador principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEUS PASSOS DE HOJE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9685A8"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/txtPassos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passos: 0"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#57446F"
                android:paddingTop="15dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meta diária: 5000 passos"
                android:textSize="15sp"
                android:textColor="#93869F" />

            <!-- Gráfico personalizado -->
            <com.app.meuspassos.GraficoPassos
                android:id="@+id/grafico"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="15dp" />

        </LinearLayout>

        <!-- Localização -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Localização"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#57446F"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUA POSIÇÃO ATUAL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#9685A8" />

            <TextView
                android:id="@+id/txtLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Localização ainda não obtida"
                android:textSize="14sp"
                android:textColor="#57446F"
                android:paddingTop="12dp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Botões -->
        <Button
            android:id="@+id/btnLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Obter localização"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9074B2"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="Salvar registro"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#57446F"
            android:backgroundTint="#E5DCF0"
            android:textAllCaps="false" />

        <!-- Histórico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Histórico de atividades"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#57446F"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhum registro salvo"
            android:textSize="14sp"
            android:textColor="#57446F"
            android:lineSpacingExtra="6dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp" />

    </LinearLayout>

</ScrollView>
