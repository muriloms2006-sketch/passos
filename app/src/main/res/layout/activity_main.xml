<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo"
            android:textSize="15sp"
            android:textColor="@color/texto_secundario"
            android:gravity="center"
            android:paddingBottom="25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/superficie"
            android:elevation="4dp"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotulo_passos_hoje"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/rotulo"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/txtPassos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1.234"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/texto"
                android:paddingTop="15dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Meta diária: 5000 passos"
                android:textSize="15sp"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtEstatisticas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0,96 km · 49 kcal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/texto"
                android:paddingTop="6dp" />

            <com.app.meuspassos.GraficoPassos
                android:id="@+id/grafico"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="15dp" />

            <TextView
                android:id="@+id/txtFonteSensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/fonte_sensor_passos"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario" />

            <Button
                android:id="@+id/btnZerar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/botao_zerar"
                android:textColor="@color/primaria"
                android:textAllCaps="false" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_localizacao"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/superficie"
            android:elevation="3dp"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotulo_posicao_atual"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/rotulo" />

            <TextView
                android:id="@+id/txtLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/localizacao_nao_obtida"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:paddingTop="12dp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="@string/botao_obter_localizacao"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:backgroundTint="@color/primaria"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="@string/botao_salvar"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:backgroundTint="@color/primaria_clara"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_historico"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/historico_vazio"
            android:textSize="14sp"
            android:textColor="@color/texto"
            android:lineSpacingExtra="6dp"
            android:background="@color/superficie"
            android:elevation="3dp"
            android:padding="18dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp" />

    </LinearLayout>

</ScrollView>
